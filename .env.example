# Copy to .env and fill in. .env is git-ignored.

# Local Postgres via docker-compose (see docker-compose.yml)
DATABASE_URL="postgresql://proposal:proposal@localhost:5432/proposalbuilder?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
# Use a different, freshly generated value in production — never reuse this.
AUTH_SECRET=""

# Base URL of the app
AUTH_URL="http://localhost:3000"

# Where uploaded logos/generated files live. Must point at a persistent volume
# on any host where the filesystem doesn't survive a redeploy.
STORAGE_DIR="./.storage"

# --- Production-only (leave unset for local dev) --------------------------

# Required behind a reverse proxy on most hosts (Railway, Render, a VPS behind
# nginx). Vercel sets this for you; see src/auth.ts.
# AUTH_TRUST_HOST="true"

# Only set this if Puppeteer's bundled Chromium won't launch on your host —
# points at a system Chromium/Chrome binary instead. See src/lib/render/pdf.ts.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
